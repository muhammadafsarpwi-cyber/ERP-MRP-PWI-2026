# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL_REJECT_UNAUTHORIZED=true
DB_DATABASE=erp_database
DB_SCHEMA=public
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_REDIRECT_URL=http://localhost:3000/login

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_MAX_SIZE=10485760

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@erp.com

# Frontend
REACT_APP_API_URL=http://localhost:3001/api/v1

# ── AI Assistant (Text-to-SQL + Voice) ──────────────────────────────────────
# Google Gemini powers natural-language → SQL. Create a key (free tier OK):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000
# How many times the engine may ask Gemini to repair a rejected/failed SQL.
AI_MAX_REPAIR_ATTEMPTS=2
# OpenAI Whisper powers Speech-to-Text for the voice endpoint.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
AI_STT_TIMEOUT_MS=60000
AI_MAX_AUDIO_BYTES=26214400
# Dedicated READ-ONLY database role (created by
# supabase/migrations/20261015000000_erp_00073_ai_assistant.sql).
# SELECT-only grants + default_transaction_read_only=on + statement timeouts.
AI_DB_USERNAME=erp_ai_reader
AI_DB_PASSWORD=ChangeMe_AiReader_Str0ng!
AI_DB_POOL_MAX=4
AI_DB_CONNECT_TIMEOUT_MS=10000
# Query guardrails
AI_QUERY_TIMEOUT_MS=15000
AI_QUERY_MAX_ROWS=500
AI_SCHEMA_CACHE_TTL_MS=900000
# Let Gemini polish the "no records found" message (Urdu + English).
AI_EMPTY_STATE_NARRATE=true

# ── Universal Recycle Bin (soft-delete auto-purge) ─────────────────────────
# The purge scheduler runs a rolling daily sweep at 03:00 LOCAL time and
# permanently destroys rows that have sat in the bin longer than the retention
# window. ONE SWITCH, TWO MODES:
#
#   unset / false  DRY-RUN LOG MODE (the default). The sweep runs, identifies
#                  the rows that HAVE passed the window, and reports them in
#                  the server log. NOTHING is written or destroyed. Run this
#                  first and read the daily delta before arming for real.
#   true           LIVE. Expired rows are permanently destroyed, children before
#                  parents, each table in its own transaction.
#
# Requires migration 1806000000000-AddSoftDeleteColumns.ts to have been applied;
# an unmigrated table is skipped and logged rather than crashing the sweep.
RECYCLE_BIN_AUTO_PURGE=false
RECYCLE_BIN_PURGE_RETENTION_DAYS=30
