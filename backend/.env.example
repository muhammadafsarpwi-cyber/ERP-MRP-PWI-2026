# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL_REJECT_UNAUTHORIZED=true
DB_DATABASE=erp_database
DB_SCHEMA=public
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_REDIRECT_URL=http://localhost:3000/login

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_MAX_SIZE=10485760

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@erp.com

# Frontend
REACT_APP_API_URL=http://localhost:3001/api/v1

# ── Universal Recycle Bin (soft-delete auto-purge) ─────────────────────────
# The purge scheduler runs a rolling daily sweep at 03:00 LOCAL time and
# permanently destroys rows that have sat in the bin longer than the retention
# window. ONE SWITCH, TWO MODES:
#
#   unset / false  DRY-RUN LOG MODE (the default). The sweep runs, identifies
#                  the rows that HAVE passed the window, and reports them in
#                  the server log. NOTHING is written or destroyed. Run this
#                  first and read the daily delta before arming for real.
#   true           LIVE. Expired rows are permanently destroyed, children before
#                  parents, each table in its own transaction.
#
# Requires migration 1806000000000-AddSoftDeleteColumns.ts to have been applied;
# an unmigrated table is skipped and logged rather than crashing the sweep.
RECYCLE_BIN_AUTO_PURGE=false
RECYCLE_BIN_PURGE_RETENTION_DAYS=30
