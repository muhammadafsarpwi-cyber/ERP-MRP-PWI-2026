# Local development does NOT hardcode an API URL.
# When REACT_APP_API_URL is unset, src/services/api.ts derives the base URL from
# the browser hostname: http://<hostname>:3001/api/v1. This works from
# localhost AND from LAN addresses (e.g. http://192.168.100.9:3000), and never
# hits the deployed Render API during development.
#
# Production builds use REACT_APP_API_URL from .env (Render):
#   REACT_APP_API_URL=https://erp-mrp-pwi-2026.onrender.com/api/v1