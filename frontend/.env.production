# Production API (Vercel frontend -> Render NestJS API).
# Intentionally lives in .env.production (loaded only by `npm run build`,
# NODE_ENV=production) so local `npm start` derives the API base URL from the
# browser hostname instead of reaching the deployed Render API.
REACT_APP_API_URL=https://erp-mrp-pwi-2026.onrender.com/api/v1